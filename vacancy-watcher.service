[Unit]
Description=Job Hunter Vacancy Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/job-hunter
Environment="PATH=/opt/job-hunter/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/job-hunter/venv/bin/python -m app.main

# Restart on failure
Restart=on-failure
RestartSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vacancy-watcher

[Install]
WantedBy=multi-user.target
