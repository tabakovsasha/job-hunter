[Unit]
Description=Vacancy Watcher Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/job-hunter
Environment="PATH=/opt/job-hunter/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/job-hunter/venv/bin/python -m app.bot
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
