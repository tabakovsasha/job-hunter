# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your personal Chat ID (only you can control the bot)
# Get it from @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# Search queries (comma-separated)
SEARCH_QUERIES=presale

# Enable/disable providers
ENABLE_VK=true
ENABLE_YANDEX=true

# HTTP settings
HTTP_TIMEOUT=30
USER_AGENT=VacancyWatcher/1.0
